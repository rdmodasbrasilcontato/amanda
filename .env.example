# ─────────────────── OPENAI ───────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_MS=45000

# ─────────────────── SUPABASE ───────────────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET_AUDIO=amanda-audios
SUPABASE_STORAGE_BUCKET_IMAGES=amanda-imagens
SUPABASE_STORAGE_BUCKET_DOCS=amanda-docs

# ─────────────────── POSTGRES ───────────────────
DATABASE_URL=postgresql://postgres:[SENHA]@db.SEU_PROJETO.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_URL=postgresql://postgres.SEU_PROJETO:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=true

# ─────────────────── Z-API ───────────────────
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN
ZAPI_BASE_URL=https://api.z-api.io/instances/SEU_INSTANCE_ID/token/SEU_TOKEN
ZAPI_WEBHOOK_VERIFY_TOKEN=gerar_string_aleatoria_segura
ZAPI_AUTO_READ=true
ZAPI_TYPING_DELAY_MS=1500

# ─────────────────── REDIS ───────────────────
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:[PORT]
REDIS_TLS=true
REDIS_TTL_SESSION_SECONDS=86400
REDIS_TTL_DEBOUNCE_SECONDS=8

# ─────────────────── APP ───────────────────
NODE_ENV=production
PORT=3000
APP_NAME=Amanda AI
APP_VERSION=1.0.0
WEBHOOK_BASE_URL=https://SEU-DOMINIO.com
FRONTEND_URL=https://painel.SEU-DOMINIO.com
ALLOWED_ORIGINS=https://painel.SEU-DOMINIO.com
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# ─────────────────── NEGÓCIO ───────────────────
BUSINESS_NAME=RD Modas Brasil
BUSINESS_PHONE=
BUSINESS_INSTAGRAM=https://www.instagram.com/rdmodasbrasil/
BUSINESS_WEBSITE=https://rdmodasbrasil.com.br
BUSINESS_GOOGLE_MAPS=https://www.google.com/maps/place/RD+MODAS+BRASIL

# ─────────────────── AMANDA ───────────────────
AMANDA_PERSONA_VERSION=v8
AMANDA_DEBOUNCE_MS=8000
AMANDA_TYPING_MIN_MS=1200
AMANDA_TYPING_MAX_MS=3800
AMANDA_AUDIO_REPLY_PROBABILITY=0.15
AMANDA_FOLLOWUP_HOURS_1=2
AMANDA_FOLLOWUP_HOURS_2=24
AMANDA_FOLLOWUP_HOURS_3=72
AMANDA_HANDOFF_KEYWORDS=humano,atendente,vendedor,gerente

# ─────────────────── SEGURANÇA ───────────────────
JWT_SECRET=gerar_com_openssl_rand_base64_64
ADMIN_API_KEY=gerar_chave_admin_segura
RATE_LIMIT_PER_MINUTE=60
ENCRYPTION_KEY=gerar_chave_aes256

# ─────────────────── OBSERVABILIDADE ───────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_TRANSPORT=stdout
