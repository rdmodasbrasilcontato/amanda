# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# ─── Supabase (opcional — se usar Supabase) ───────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Redis (opcional — melhora debounce e deduplicação) ───
REDIS_URL=redis://localhost:6379

# ─── Z-API ────────────────────────────────────────────────
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# ─── App ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
WEBHOOK_BASE_URL=http://SEU_IP_PUBLICO:3000
ADMIN_API_KEY=troque_esta_senha_agora
LOG_LEVEL=info

# ─── Negócio ──────────────────────────────────────────────
BUSINESS_NAME=RD Modas Brasil
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20

# ─── Follow-up (tempos configuráveis) ─────────────────────
FOLLOWUP_DELAY_1_MIN=20
FOLLOWUP_DELAY_2_HRS=3
FOLLOWUP_DELAY_3_HRS=8
FOLLOWUP_DELAY_4_HRS=24
FOLLOWUP_DELAY_5_HRS=72
FOLLOWUP_DELAY_6_HRS=168
FOLLOWUP_DELAY_7_HRS=360
FOLLOWUP_DELAY_8_HRS=720

# ─── Anti-spam ────────────────────────────────────────────
ANTISPAM_DAILY_LIMIT=3
ANTISPAM_MIN_COOLDOWN_HOURS=4
